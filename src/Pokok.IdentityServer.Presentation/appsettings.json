{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=Pokok.IdentityServer.Presentation;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "EmailTemplates": {
    "Templates": {
      "UserRegistrationConfirmation": {
        "Subject": "Confirm your account",
        "Body": "Hi {DisplayName}, please confirm your account by clicking here: {CallbackUrl}"
      },
      "PasswordReset": {
        "Subject": "Reset Your Password",
        "Body": "<p>Hi {DisplayName},</p><p>You have requested to reset your password.</p><p>Please reset your password by <a href='{CallbackUrl}'>clicking here</a>.</p><p>If you did not request a password reset, please ignore this email.</p><p>Thanks,<br/>The Pokok Team</p>"
      }
    }
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "Interval": "00:00:15"
  },
  "IdentityServer": {
    "Clients": [
      {
        "ClientId": "pokok-portal",
        "ClientName": "Pokok JMB Portal",
        "GrantTypes": [ "password" ],
        "RequireClientSecret": false,
        "AllowedScopes": [ "openid", "profile", "pokok.api" ],
        "AllowOfflineAccess": true,
        "AccessTokenLifetime": 3600
      }
    ]
  },
  "SeedData": {
    "DefaultTenant": {
      "Id": "default-tenant",
      "Name": "Default Tenant",
      "Subdomain": "default"
    },
    "AdminUser": {
      "_comment": "In production, use environment variables or Azure Key Vault instead",
      "Email": "",
      "Password": "",
      "DisplayName": "System Administrator"
    }
  }
}