@page
@model Pokok.IdentityServer.Presentation.Areas.Admin.Pages.Tenants.CreateModel
@{
    ViewData["Title"] = "Create Tenant";
}

<div class="container mt-4">
    <h1>Create New Tenant</h1>

    <div class="row">
        <div class="col-md-8">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Subdomain" class="form-label"></label>
                    <input asp-for="Input.Subdomain" class="form-control" placeholder="tenant1" />
                    <span asp-validation-for="Input.Subdomain" class="text-danger"></span>
                    <div class="form-text">Users will access via subdomain (optional). Use lowercase letters, numbers, and hyphens only.</div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label"></label>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Create Tenant</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
